# ============================================================
# Environment Variables — copy to .env and fill in the values.
# NEVER commit .env (it is in .gitignore).
# ============================================================

# Django Core
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: sqlite (single local instance) or postgresql (multi-tenant)
DB_ENGINE=sqlite

# PostgreSQL (used only when DB_ENGINE=postgresql; DB_PASSWORD is required then)
DB_NAME=easysupermarket
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
